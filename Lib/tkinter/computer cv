import tkinter as tk
from tkinter import messagebox

# Colors and Fonts
TITLE_FONT = ("Helvetica", 16, "bold")
LABEL_FONT = ("Helvetica", 14)
INPUT_FONT = ("Helvetica", 14)
TITLE_COLOR = "#0066CC"  # Blue color

def generate_cv():
    name = entry_name.get()
    phone = entry_phone.get()
    email = entry_email.get()
    education = entry_education.get()
    experience = entry_experience.get()
    skills = entry_skills.get()

    if not name or not phone or not email:
        messagebox.showerror("Error", "Please fill in all required fields.")
        return
    
    cv_text = f"""
Name: {name}
Phone: {phone}
Email: {email}

Education:
{education}

Experience:
{experience}

Skills:
{skills}
"""
    text_cv.config(fg="black", bg="#f9f9f9", font=INPUT_FONT)
    text_cv.delete(1.0, tk.END)
    text_cv.insert(tk.END, cv_text)

# Create GUI window
root = tk.Tk()
root.title("Beautiful English CV Project")
root.configure(bg="white")

# Title Label
title_label = tk.Label(root, text="My English CV", font=TITLE_FONT, fg=TITLE_COLOR, bg="white")
title_label.grid(row=0, column=0, columnspan=2, pady=15)

# Labels and Entries
labels = ["Name:", "Phone:", "Email:", "Education:", "Experience:", "Skills:"]
entries = []

for i, text in enumerate(labels, start=1):
    label = tk.Label(root, text=text, font=LABEL_FONT, fg=TITLE_COLOR, bg="white")
    label.grid(row=i, column=0, sticky="e", padx=10, pady=5)
    
    entry = tk.Entry(root, font=INPUT_FONT, width=40)
    entry.grid(row=i, column=1, padx=10, pady=5)
    entries.append(entry)

entry_name, entry_phone, entry_email, entry_education, entry_experience, entry_skills = entries

# Textbox to show CV
text_cv = tk.Text(root, width=60, height=15, font=INPUT_FONT, bg="#f9f9f9", fg="black")
text_cv.grid(row=7, column=0, columnspan=2, padx=10, pady=15)

# Generate CV Button
btn_generate = tk.Button(root, text="Generate CV", font=TITLE_FONT, bg=TITLE_COLOR, fg="white", command=generate_cv)
btn_generate.grid(row=8, column=0, columnspan=2, pady=10)

root.mainloop()
